# Demo is explicit and must never be enabled on a public production server.
# It stores everything in data/ (embedded Postgres + local assets) and signs you in as the seeded owner.
SPACIE_DEMO_MODE=true
SPACIE_ORIGIN=http://localhost:3000

# PostgreSQL 15+. Tables live in the `spacie` schema; migrations run on boot and via `npm run db:migrate`.
DATABASE_URL=
DATABASE_POOL_SIZE=10

# Local state (demo database, and uploaded files when no bucket is configured). Defaults to ./data.
SPACIE_DATA_DIR=

# Optional S3-compatible object storage (Cloudflare R2, Hetzner Object Storage, …).
# Leave empty to store uploads on local disk under SPACIE_DATA_DIR/assets.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Signs direct-upload tickets when object storage is used. `openssl rand -base64 48`.
SPACIE_UPLOAD_SECRET=
