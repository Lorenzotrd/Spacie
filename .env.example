# Demo is explicit and must never be enabled on a public production server.
# It stores everything in data/ (embedded Postgres + local assets) and signs you in as the seeded owner.
SPACIE_DEMO_MODE=true
SPACIE_ORIGIN=http://localhost:3000

# PostgreSQL 15+ (self-hosted, or a Supabase direct/session connection string).
# Tables live in the `spacie` schema; migrations run on boot and via `npm run db:migrate`.
DATABASE_URL=
DATABASE_POOL_SIZE=10

# Signs direct-upload tickets. At least 32 random characters: `openssl rand -base64 48`.
SPACIE_UPLOAD_SECRET=

# Human sign-in (magic links, invitations) through Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# S3-compatible object storage (Cloudflare R2, Hetzner Object Storage, …).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
